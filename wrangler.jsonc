{
  "name": "latest-trailers",
  "compatibility_date": "2025-10-24",
  "main": "./index.js",
  "assets": {
    "directory": "./frontend/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/showing.json", "/upcoming.json", "/__scheduled"]
  },
  "kv_namespaces": [{ "binding": "trailerCache" }],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
